# ============================================
# Python Flask 프로젝트용 .gitignore
# ============================================
# 이 파일은 Git에 올리지 말아야 할 파일들을 지정합니다

# ===== 환경 변수 파일 (API 키 등 민감한 정보) =====
# ⚠️ 매우 중요! 절대 Git에 올리면 안 됩니다!
.env
.env.local
.env.*.local

# ===== Python 관련 =====
# Python 캐시 파일 (자동 생성되는 파일들)
__pycache__/
*.py[cod]
*$py.class

# Python 컴파일된 파일
*.so

# 배포 관련
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/

# ===== 가상환경 (Virtual Environment) =====
# 프로젝트마다 독립적인 Python 환경을 만들 때 생성됩니다
venv/
env/
ENV/
.venv
.ENV

# ===== 데이터베이스 =====
# SQLite 데이터베이스 파일 (개발 중 생성되는 파일)
*.db
*.sqlite
*.sqlite3
database/*.db

# ===== IDE / 에디터 설정 파일 =====
# Visual Studio Code
.vscode/
!.vscode/extensions.json  # 확장 프로그램 추천은 공유

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# ===== 운영체제 파일 =====
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ===== 로그 파일 =====
*.log
logs/
*.log.*

# ===== 테스트 관련 =====
.pytest_cache/
.coverage
htmlcov/
.tox/

# ===== 기타 =====
# 임시 파일
*.tmp
*.bak
*.swp
*.swo

# 백업 파일
*.backup
