# 환경 변수 예시 파일
# 이 파일은 Git에 올라가도 안전합니다 (실제 키가 없으니까요!)
#
# 사용 방법:
# 1. 이 파일을 복사해서 ".env" 파일로 만드세요
# 2. 아래 값들을 실제 값으로 바꾸세요
# 3. .env 파일은 절대 Git에 올리지 마세요!

# Claude API 키
# Anthropic 웹사이트(https://console.anthropic.com/)에서 발급받을 수 있습니다
# 형식: sk-ant-api03-...으로 시작하는 긴 문자열
CLAUDE_API_KEY=여기에_실제_API_키를_붙여넣으세요

# Flask 시크릿 키 (세션 암호화에 사용)
# 아무 랜덤 문자열을 입력하세요 (길수록 안전합니다)
# 예: keyboard_cat_12345_랜덤문자열
FLASK_SECRET_KEY=여기에_랜덤한_문자열을_입력하세요

# Flask 실행 환경
# development: 개발 모드 (에러 메시지 자세히 표시, 코드 변경 시 자동 재시작)
# production: 배포 모드 (나중에 실제 서비스 시 사용)
FLASK_ENV=development

# 디버그 모드 (개발할 때는 True, 배포할 때는 False)
FLASK_DEBUG=True
