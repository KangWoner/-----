# Gemini API Key (필수)
# https://makersuite.google.com/app/apikey 에서 API 키를 발급받으세요
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Unsplash API Key (선택사항 - 이미지 검색)
# https://unsplash.com/developers 에서 API 키를 발급받으세요
VITE_UNSPLASH_API_KEY=your_unsplash_api_key_here

# Pexels API Key (선택사항 - 이미지 검색)
# https://www.pexels.com/api/ 에서 API 키를 발급받으세요
VITE_PEXELS_API_KEY=your_pexels_api_key_here

# News API Key (선택사항 - 실제 뉴스 검색)
# https://newsapi.org 에서 API 키를 발급받으세요
VITE_NEWS_API_KEY=your_news_api_key_here

# GNews API Key (선택사항 - 실제 뉴스 검색)
# https://gnews.io 에서 API 키를 발급받으세요
VITE_GNEWS_API_KEY=your_gnews_api_key_here
